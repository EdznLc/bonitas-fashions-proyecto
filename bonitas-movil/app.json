{
  "expo": {
    "name": "Bonitas Fashions Admin",
    "slug": "bonitas-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#faf6f8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
